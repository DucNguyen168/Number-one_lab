# Copy values into Botkeep Environment. Put the real URI in a secret.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/
MONGODB_DATABASE=xsmb_research
APP_TIMEZONE=Asia/Ho_Chi_Minh
ENABLE_SCHEDULER=true
SYNC_ON_STARTUP=true
AUTO_PREDICTION=true
AUTO_PREDICTION_COUNT=65
PREDICTION_TIME=17:00
RESULT_POLL_START_TIME=18:30
RESULT_POLL_INTERVAL_SECONDS=10
RESULT_SYNC_TIMES=18:30,18:50,19:10
BACKFILL_WORKERS=1
SKIP_COMPLETED_HISTORY=true
HTTP_TIMEOUT_SECONDS=12
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_RETRIES=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
PYTHONUNBUFFERED=1
PIP_NO_CACHE_DIR=1
# Set PORT to the actual port allocated by the panel, not an arbitrary value.
# PORT=8000
# Do not copy VERCEL, VERCEL_ENV or VERCEL_URL from Vercel.
