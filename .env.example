# Cấu hình môi trường — XSMB Research Lab
# Sao chép file này thành `.env` và điền giá trị phù hợp.

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=xsmb_research

# ── App ───────────────────────────────────────────────────
APP_TIMEZONE=Asia/Ho_Chi_Minh
KQXS_BASE_URL=https://www.kqxs.vn
XOSODAIPHAT_BASE_URL=https://xosodaiphat.com
HTTP_TIMEOUT_SECONDS=12
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_RETRIES=1
BACKFILL_WORKERS=4
SKIP_COMPLETED_HISTORY=true

# ── Scheduler ─────────────────────────────────────────────
ENABLE_SCHEDULER=true
SYNC_ON_STARTUP=true
SCHEDULER_RETRY_ATTEMPTS=3
SCHEDULER_RETRY_DELAY_SECONDS=5

# Tự động tạo prediction mỗi ngày lúc PREDICTION_TIME
AUTO_PREDICTION=true
# Số lượng số được chọn (60–80); mặc định 65
AUTO_PREDICTION_COUNT=65
# Giờ khóa dự đoán (trước giờ quay 18:15)
PREDICTION_TIME=17:30
# Các mốc đồng bộ kết quả sau kỳ quay
RESULT_SYNC_TIMES=18:35,18:50,19:10

# ── AI API Key (Tùy chọn) ─────────────────────────────────
# Mục đích: Lớp giải thích bổ sung, KHÔNG phải engine chọn số.
# Khi cấu hình, AI có thể được dùng để:
#   1. Diễn giải tự nhiên tại sao top N số được chọn hôm nay
#   2. Phát hiện phân phối bất thường so với lịch sử
#   3. Tóm tắt insight từ dữ liệu gần đây
# LƯU Ý: AI không được phép override kết quả từ statistical model.
# Để trống = chạy hoàn toàn local, không gửi dữ liệu ra ngoài.
AI_API_KEY=
