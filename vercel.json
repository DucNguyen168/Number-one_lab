{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "fastapi",
  "fluid": true,
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,docs/**,scripts/**,reports/**,deploy/**,.venv/**,.git/**,.env,.env.*,**/__pycache__/**,**/.pytest_cache/**}"
    }
  },
  "crons": [
    {
      "path": "/api/auto-daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "50 11 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "10 12 * * *"
    }
  ]
}
