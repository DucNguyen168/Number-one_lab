{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-daily",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "35 11 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "50 11 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "10 12 * * *"
    }
  ]
}
