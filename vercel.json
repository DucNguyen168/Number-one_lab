{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "fluid": true,
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docs/**,scripts/**,reports/**,claudekit-engineer/**,**/__pycache__/**,**/.pytest_cache/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "50 11 * * *"
    },
    {
      "path": "/api/auto-daily",
      "schedule": "10 12 * * *"
    }
  ]
}
